# 服务端监听
PORT=7428
HOST=127.0.0.1

# 前端静态目录（构建产物 apps/web/dist；留空则只提供 API）
# SH_WEB_DIST=./apps/web/dist

# SQLite 数据库文件（生产环境指向 NAS SMB 挂载路径）
SH_DB_PATH=./data/session-hub.db

# 单一固定 Bearer token（必填，至少 8 位）
SH_AUTH_TOKEN=change-me-to-a-long-random-token

# embedding 提供商配置文件（缺省 ./config/providers.json，样例/兜底）
# SH_PROVIDERS_FILE=./config/providers.json

# Web 系统设置写入的提供商配置文件（存在则优先于上面；gitignore，可含真实密钥）
# SH_PROVIDERS_LOCAL_FILE=./config/providers.local.json

# 后台自动补索引轮询间隔（毫秒，最小 5000，默认 30000；保存提供商配置后会立即提前触发一轮）
# SH_AUTO_INDEX_INTERVAL_MS=30000

# 若仍需走代理拉取境外资源（Node fetch 默认不读系统代理，需 NODE_USE_ENV_PROXY）
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809

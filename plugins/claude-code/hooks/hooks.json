{
  "description": "Claude Code session collector hooks for Session Hub",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["dist/hook.js"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["dist/hook.js"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["dist/hook.js"],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
